# Proxy API requests to Render backend server seamlessly
/api/*       https://bics-portal.onrender.com/api/:splat  200!

# Proxy Assessment requests to the separate OT deployment site
/assessment    https://otbicsexam.netlify.app/assessment/test  200!
/assessment/*  https://otbicsexam.netlify.app/assessment/:splat  200!

# Legacy /terminal redirect to /assessment
/terminal      /assessment/test                              301!
/terminal/*    /assessment/:splat                            301!

# Proxy Athenaeum, Workspace & Kata requests to the separate Workspace deployment site
/athenaeum    https://bicsworkspace.netlify.app/athenaeum/kata  200!
/athenaeum/*  https://bicsworkspace.netlify.app/athenaeum/:splat  200!
/workspace    /athenaeum/kata  301!
/workspace/*  /athenaeum/:splat  301!
/kata         https://bicsworkspace.netlify.app/athenaeum/kata  200!
/kata/*       https://bicsworkspace.netlify.app/athenaeum/kata/:splat  200!
/contests     https://bicsworkspace.netlify.app/athenaeum/contests  200!
/contests/*   https://bicsworkspace.netlify.app/athenaeum/contests/:splat  200!
/contest/*    https://bicsworkspace.netlify.app/athenaeum/contest/:splat  200!
/problemset   https://bicsworkspace.netlify.app/athenaeum/problemset  200!
/problemset/* https://bicsworkspace.netlify.app/athenaeum/problemset/:splat  200!
/gym          https://bicsworkspace.netlify.app/athenaeum/gym  200!
/gym/*        https://bicsworkspace.netlify.app/athenaeum/gym/:splat  200!
/submissions  https://bicsworkspace.netlify.app/athenaeum/submissions  200!
/submissions/* https://bicsworkspace.netlify.app/athenaeum/submissions/:splat  200!
/status       https://bicsworkspace.netlify.app/athenaeum/status  200!
/status/*     https://bicsworkspace.netlify.app/athenaeum/status/:splat  200!

