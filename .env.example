# ==========================================
# BICS Evaluation Cluster Environment Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI or local fallback)
MONGO_URI=mongodb://127.0.0.1:27017/bics_portal

# JWT Secrets for Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_STUDENT_EXPIRES_IN=24h

# Administrator Access Credentials
ADMIN_USER=admin
ADMIN_PASS=admin_secure_password_here

# -------------------------------------------------------------
# BICS Terminal BIOS Invigilator PIN Security
# -------------------------------------------------------------
# Secret 4-digit numeric PIN for on-site technicians & hall invigilators
# to access terminal cache vault and network tools.
# Required by POST /api/tests/bios/verify-pin. Fails closed if not set.
INVIGILATOR_BIOS_SECRET_PIN=7492

# Media Cloudinary Storage (Optional for photo/snapshot captures)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Models (Optional for Katas & automated marking)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
